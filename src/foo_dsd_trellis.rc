#include "resource.h"
#include <windows.h>
#include <commctrl.h>

IDD_DSP_TRELLIS DIALOGEX 0, 0, 400, 395
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "DSD Trellis SDM Configuration"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_LIST_RATEMAP, WC_LISTVIEW, LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 8, 8, 384, 165

    LTEXT           "Threads:", -1, 8, 180, 35, 8
    EDITTEXT        IDC_EDIT_THREADS, 45, 178, 40, 14, ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "", IDC_SPIN_THREADS, "msctls_updown32", UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS, 73, 178, 11, 14

    LTEXT           "Input Format:", -1, 110, 180, 50, 8
    COMBOBOX        IDC_COMBO_FORMAT, 162, 178, 90, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    CONTROL         "Debug log (foo_dsd_trellis.log)", IDC_CHECK_DEBUG_LOG, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 270, 180, 130, 10

    GROUPBOX        "Path Info", -1, 8, 198, 384, 80
    LTEXT           "Select a rate mapping to see path details.", IDC_STATIC_PATH_INFO, 16, 210, 368, 62

    CONTROL         "Anti-pop lead-in", IDC_CHECK_ANTIPOP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 286, 80, 10

    CONTROL         "ML Noise Filter", IDC_CHECK_ML_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 302, 80, 10
    LTEXT           "Device:", -1, 92, 302, 28, 8
    COMBOBOX        IDC_COMBO_ML_EP, 122, 300, 80, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_STATIC_ML_STATUS, 208, 302, 100, 8

    DEFPUSHBUTTON   "OK", IDOK, 288, 373, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 342, 373, 50, 14
END
