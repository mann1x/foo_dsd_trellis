#include "resource.h"
#include <windows.h>
#include <commctrl.h>

IDD_DSP_TRELLIS DIALOGEX 0, 0, 420, 380
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "DSD Trellis SDM Configuration"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_LIST_RATEMAP, WC_LISTVIEW, LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 8, 8, 404, 140

    LTEXT           "Threads:", -1, 8, 156, 50, 8
    EDITTEXT        IDC_EDIT_THREADS, 50, 154, 48, 14, ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "", IDC_SPIN_THREADS, "msctls_updown32", UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS, 86, 154, 11, 14

    LTEXT           "Input Format:", -1, 120, 156, 50, 8
    COMBOBOX        IDC_COMBO_FORMAT, 172, 154, 90, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    CONTROL         "Debug log (foo_dsd_trellis.log)", IDC_CHECK_DEBUG_LOG, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 280, 156, 130, 10

    GROUPBOX        "Path Info", -1, 8, 194, 404, 88
    LTEXT           "Select a rate mapping to see path details.", IDC_STATIC_PATH_INFO, 16, 206, 388, 70

    CONTROL         "Anti-pop lead-in", IDC_CHECK_ANTIPOP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 290, 80, 10

    CONTROL         "ML Noise Filter", IDC_CHECK_ML_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 306, 80, 10
    LTEXT           "Device:", -1, 92, 306, 28, 8
    COMBOBOX        IDC_COMBO_ML_EP, 122, 304, 80, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_STATIC_ML_STATUS, 208, 306, 100, 8

    DEFPUSHBUTTON   "OK", IDOK, 308, 358, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 362, 358, 50, 14
END
